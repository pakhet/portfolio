---
import Base from '../layouts/Base.astro';
import ConstellationCat from '../components/ConstellationCat.astro';
import { profile, stats, certifications, education, skills, community } from '../data/profile';
---

<Base>
  <section class="hero">
    <div class="intro">
      <p class="eyebrow">{profile.focus.join(' · ')}</p>
      <h1 class="gradient-text">{profile.name}</h1>
      <p class="lead">{profile.headline} <span class="muted">in {profile.location}</span></p>
      {profile.summary.map((p) => <p class="muted">{p}</p>)}
      <div class="cta">
        <a class="btn" href="/experience">View experience</a>
        <a class="btn ghost" href={profile.links.linkedin} rel="noopener noreferrer" target="_blank">Connect on LinkedIn</a>
      </div>
    </div>
    <div class="art"><ConstellationCat /></div>
  </section>

  <ul class="stats">
    {stats.map((s) => (
      <li class="card hud">
        <span class="value mono">{s.value}</span>
        <span class="label muted">{s.label}</span>
      </li>
    ))}
  </ul>

  <h2 class="section">Skills</h2>
  <div class="skills">
    {skills.map((g) => (
      <div class="card">
        <h3 class="mono">{g.group}</h3>
        <ul class="tags">{g.items.map((s) => <li>{s}</li>)}</ul>
      </div>
    ))}
  </div>

  <div class="two">
    <section>
      <h2 class="section">Education & certifications</h2>
      <div class="card">
        <p class="m0"><strong>{education.degree}</strong></p>
        <p class="m0 muted">{education.school} · {education.years}</p>
        <ul class="tags">{certifications.map((c) => <li>{c}</li>)}</ul>
      </div>
    </section>
    <section>
      <h2 class="section">Community</h2>
      <div class="card">
        <p class="m0"><strong>{community.title}, {community.org}</strong></p>
        <p class="m0 muted mono small">{community.start} – {community.end}</p>
        <ul class="points">{community.points.map((pt) => <li>{pt}</li>)}</ul>
      </div>
    </section>
  </div>
</Base>

<style>
  .hero { display: grid; grid-template-columns: 1.4fr 1fr; gap: 2rem; align-items: center; padding: 1rem 0 2rem; }
  .lead { font-size: 1.25rem; margin: 0 0 1rem; }
  .cta { display: flex; gap: 0.75rem; flex-wrap: wrap; margin-top: 1.75rem; }
  .art { display: flex; justify-content: center; }
  @media (max-width: 760px) {
    .hero { grid-template-columns: 1fr; }
    .art { order: -1; max-width: 140px; margin: 0 auto; }
  }
  .stats { list-style: none; padding: 0; margin: 1rem 0 0; display: grid; grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)); gap: 1rem; }
  .stats li { display: flex; flex-direction: column; gap: 0.3rem; }
  .value { font-size: 1.8rem; font-weight: 700; color: var(--accent); text-shadow: var(--glow); }
  .label { font-size: 0.88rem; line-height: 1.4; }
  .skills { display: grid; grid-template-columns: repeat(auto-fit, minmax(280px, 1fr)); gap: 1rem; }
  .skills h3 { font-size: 0.9rem; color: var(--accent-2); text-transform: lowercase; }
  .two { display: grid; grid-template-columns: repeat(auto-fit, minmax(300px, 1fr)); gap: 0 1.5rem; }
  .m0 { margin: 0; }
  .small { font-size: 0.85rem; }
  .points { margin: 0.75rem 0 0; padding-left: 1.2rem; }
  .points li::marker { content: '✦  '; color: var(--accent); }
</style>
