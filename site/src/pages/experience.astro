---
import Base from '../layouts/Base.astro';
import { experience } from '../data/profile';
---

<Base title="Experience">
  <p class="eyebrow">Career log</p>
  <h1>Experience</h1>
  <p class="muted intro">From the SOC phones to running the team, newest first.</p>

  <ol class="timeline">
    {experience.map((job, i) => (
      <li class={`entry ${i === 0 ? 'latest' : ''}`}>
        <span class="node" aria-hidden="true"></span>
        <p class="when mono">{job.start} <span class="arrow">→</span> {job.end}</p>
        <div class="card hud">
          <header class="head">
            <h2>{job.org}</h2>
            <span class="muted small">{job.location}</span>
          </header>
          <ol class={`roles ${job.roles.length > 1 ? 'multi' : ''}`}>
            {job.roles.map((r) => (
              <li class="role">
                <div class="role-head">
                  <h3>{r.title}</h3>
                  {r.note && <span class="note mono">{r.note}</span>}
                  {job.roles.length > 1 && <span class="dates mono muted">{r.start} – {r.end}</span>}
                </div>
                {r.highlights && (
                  <ul class="hl">{r.highlights.map((h) => <li>{h}</li>)}</ul>
                )}
              </li>
            ))}
          </ol>
        </div>
      </li>
    ))}
  </ol>
</Base>

<style>
  .intro { margin-top: 0; }
  .timeline {
    list-style: none;
    margin: 2.5rem 0 0;
    padding: 0 0 0 2.25rem;
    position: relative;
  }
  /* The orbit line */
  .timeline::before {
    content: '';
    position: absolute;
    left: 9px; top: 6px; bottom: 6px;
    width: 2px;
    background: linear-gradient(var(--accent), var(--accent-2) 60%, transparent);
    opacity: 0.6;
  }
  .entry { position: relative; margin-bottom: 2.25rem; }
  .node {
    position: absolute;
    left: calc(-2.25rem + 3px);
    top: 4px;
    width: 14px; height: 14px;
    border-radius: 50%;
    background: var(--bg);
    border: 2px solid var(--accent-2);
  }
  .latest .node {
    background: var(--accent);
    border-color: var(--accent);
    box-shadow: var(--glow), 0 0 0 5px var(--accent-soft);
    animation: pulse 2.8s ease-in-out infinite;
  }
  @keyframes pulse { 50% { box-shadow: var(--glow), 0 0 0 9px transparent; } }
  .when { margin: 0 0 0.5rem; font-size: 0.82rem; color: var(--accent); letter-spacing: 0.04em; text-transform: uppercase; }
  .arrow { color: var(--accent-2); }
  .head { display: flex; justify-content: space-between; align-items: baseline; flex-wrap: wrap; gap: 0.25rem 1rem; }
  .head h2 { margin: 0; font-size: 1.3rem; }
  .small { font-size: 0.85rem; }
  .roles { list-style: none; padding: 0; margin: 1rem 0 0; display: grid; gap: 1.1rem; }
  /* Promotions inside one company get their own mini track */
  .roles.multi { border-left: 1px dashed var(--border); padding-left: 1rem; }
  .roles.multi .role { position: relative; }
  .roles.multi .role::before {
    content: '';
    position: absolute; left: calc(-1rem - 4px); top: 0.45rem;
    width: 7px; height: 7px; border-radius: 50%; background: var(--accent-2);
  }
  .role-head { display: flex; align-items: baseline; flex-wrap: wrap; gap: 0.25rem 0.75rem; }
  .role-head h3 { font-size: 1.02rem; }
  .dates { font-size: 0.8rem; margin-left: auto; }
  .note {
    font-size: 0.7rem; padding: 0.1rem 0.5rem; border-radius: 999px;
    color: var(--accent-3); border: 1px solid color-mix(in srgb, var(--accent-3) 45%, transparent);
  }
  .hl { margin: 0.5rem 0 0; padding-left: 1.1rem; color: var(--muted); }
  .hl li { margin: 0.3rem 0; }
  .hl li::marker { content: '▹  '; color: var(--accent); }
  @media (max-width: 520px) {
    .timeline { padding-left: 1.6rem; }
    .node { left: calc(-1.6rem + 3px); }
    .dates { margin-left: 0; width: 100%; }
  }
</style>
