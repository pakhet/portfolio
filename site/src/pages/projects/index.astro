---
import Base from '../../layouts/Base.astro';
import ProjectTabs from '../../components/ProjectTabs.astro';
import { projects, statusLabel } from '../../data/projects';
---

<Base title="Projects">
  <p class="eyebrow">Builds</p>
  <h1>Projects</h1>
  <p class="muted">Security tools I design, build, and run end to end.</p>
  <ProjectTabs />
  <div class="list">
    {projects.map((p) => (
      <a class="card item" href={`/projects/${p.slug}`}>
        <div class="row">
          <h2>{p.name}</h2>
          <span class={`status ${p.status === 'live' ? 'live' : ''}`}>{statusLabel[p.status]}</span>
        </div>
        <p class="muted">{p.tagline}</p>
      </a>
    ))}
  </div>
</Base>

<style>
  .list { display: grid; gap: 1rem; }
  .item { display: block; color: inherit; text-decoration: none; }
  .item:hover { border-color: var(--accent); }
  .row { display: flex; justify-content: space-between; align-items: center; gap: 1rem; flex-wrap: wrap; }
  .row h2 { margin: 0; font-size: 1.15rem; }
  .item p { margin: 0.4rem 0 0; }
</style>
