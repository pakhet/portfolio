---
import Base from '../../layouts/Base.astro';
import ProjectTabs from '../../components/ProjectTabs.astro';
import { projects, statusLabel } from '../../data/projects';
---

<Base title="Projects">
  <p class="eyebrow">Builds</p>
  <h1>Security projects</h1>
  <p class="muted">Tools I design, build, and operate end to end — from code to cloud infrastructure.</p>
  <ProjectTabs />
  <div class="list">
    {projects.map((p) => (
      <a class="card item" href={`/projects/${p.slug}`}>
        <div class="row">
          <h2>{p.name}</h2>
          <span class={`status ${p.status}`}>{statusLabel[p.status]}</span>
        </div>
        <p class="muted">{p.tagline}</p>
        <ul class="tags">{p.stack.map((s) => <li>{s}</li>)}</ul>
      </a>
    ))}
  </div>
</Base>

<style>
  .list { display: grid; gap: 1rem; }
  .item { display: block; color: inherit; text-decoration: none; }
  .item:hover { border-color: var(--accent); }
  .row { display: flex; justify-content: space-between; align-items: center; gap: 1rem; }
  .row h2 { margin: 0; font-size: 1.2rem; }
  .item p { margin: 0.4rem 0 0; }
  .status { font-family: var(--mono); font-size: 0.75rem; padding: 0.15rem 0.6rem; border-radius: 999px; border: 1px solid var(--border); color: var(--muted); white-space: nowrap; }
  .status.live { color: var(--accent); border-color: var(--accent); }
</style>
