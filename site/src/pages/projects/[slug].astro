---
import Base from '../../layouts/Base.astro';
import ProjectTabs from '../../components/ProjectTabs.astro';
import { projects, statusLabel, type Project } from '../../data/projects';

export function getStaticPaths() {
  return projects.map((p) => ({ params: { slug: p.slug }, props: { project: p } }));
}

const { project } = Astro.props as { project: Project };
const building = project.status !== 'live';
---

<Base title={project.name} description={`${project.name}: ${project.tagline}`}>
  <p class="eyebrow">Project</p>
  <h1>{project.name}</h1>
  <ProjectTabs active={project.slug} />

  {building ? (
    <div class="card hud construction">
      <p class="mono term"><span class="prompt">$</span> ./build {project.slug}<span class="cursor">_</span></p>
      <p><span class="status">{statusLabel[project.status]}</span></p>
      <p class="muted">This one is still on the launch pad. Check back soon.</p>
    </div>
  ) : (
    <>
      <p class="lead">{project.tagline}</p>
      {project.description?.map((d) => <p>{d}</p>)}
      {project.stack && (
        <>
          <h2 class="section">Stack</h2>
          <ul class="tags">{project.stack.map((s) => <li>{s}</li>)}</ul>
        </>
      )}
      {project.repo && <p><a href={project.repo} rel="noopener noreferrer" target="_blank">Source on GitHub →</a></p>}
    </>
  )}
</Base>

<style>
  .construction { max-width: 560px; }
  .term { margin: 0 0 1rem; color: var(--text); }
  .prompt { color: var(--accent); }
  .cursor { color: var(--accent); animation: blink 1.1s steps(1) infinite; }
  @keyframes blink { 50% { opacity: 0; } }
  .lead { font-size: 1.15rem; }
  p { max-width: 720px; }
</style>
