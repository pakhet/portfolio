---
import '../styles/global.css';
import CatLogo from '../components/CatLogo.astro';
import { profile } from '../data/profile';

interface Props {
  title?: string;
  description?: string;
}

const { title, description = `${profile.name}: ${profile.headline}. ${profile.focus.join(', ')}.` } = Astro.props;
const fullTitle = title ? `${title} · ${profile.name}` : `${profile.name} · ${profile.headline}`;
const path = Astro.url.pathname;
const nav = [
  { href: '/', label: 'about' },
  { href: '/experience', label: 'experience' },
  { href: '/projects', label: 'projects' },
];
const isActive = (href: string) => (href === '/' ? path === '/' : path.startsWith(href));
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <meta name="color-scheme" content="dark light" />
    <meta name="theme-color" content="#05070f" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <script is:inline src="/theme.js"></script>
  </head>
  <body>
    <a class="skip" href="#main">Skip to content</a>
    <header class="site-header">
      <div class="wrap bar">
        <a class="brand" href="/" aria-label="Home">
          <CatLogo />
          <span class="mono">rc<span class="cursor">_</span></span>
        </a>
        <div class="right">
          <nav aria-label="Primary">
            {nav.map((n) => (
              <a href={n.href} aria-current={isActive(n.href) ? 'page' : undefined}>{n.label}</a>
            ))}
          </nav>
          <button id="theme-toggle" class="toggle" type="button" hidden aria-label="Toggle color theme">
            <svg class="moon" viewBox="0 0 24 24" aria-hidden="true"><path d="M20 14.5A8 8 0 0 1 9.5 4a8 8 0 1 0 10.5 10.5z" /></svg>
            <svg class="sun" viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="4.5" /><path d="M12 2v2.5M12 19.5V22M2 12h2.5M19.5 12H22M4.9 4.9l1.8 1.8M17.3 17.3l1.8 1.8M4.9 19.1l1.8-1.8M17.3 6.7l1.8-1.8" /></svg>
          </button>
        </div>
      </div>
    </header>
    <main id="main" class="wrap">
      <slot />
    </main>
    <footer class="wrap site-footer muted">
      <span class="mono">© {new Date().getFullYear()} {profile.name} · <span class="purr">supervised by cats 🐾</span></span>
      <span class="links">
        <a href={profile.links.linkedin} rel="noopener noreferrer" target="_blank">LinkedIn</a>
        {profile.links.github && (
          <a href={profile.links.github} rel="noopener noreferrer" target="_blank">GitHub</a>
        )}
      </span>
    </footer>
  </body>
</html>

<style>
  .site-header {
    border-bottom: 1px solid var(--border);
    background: color-mix(in srgb, var(--bg) 78%, transparent);
    backdrop-filter: blur(10px);
    position: sticky; top: 0; z-index: 5;
  }
  .bar { display: flex; align-items: center; justify-content: space-between; gap: 1rem; height: 64px; }
  .brand { display: flex; align-items: center; gap: 0.6rem; color: var(--text); text-decoration: none; font-weight: 700; font-size: 1.1rem; }
  .cursor { color: var(--accent); animation: blink 1.1s steps(1) infinite; }
  @keyframes blink { 50% { opacity: 0; } }
  .right { display: flex; align-items: center; gap: 1rem; }
  nav { display: flex; gap: 1.1rem; }
  nav a { color: var(--muted); text-decoration: none; font-family: var(--mono); font-size: 0.88rem; }
  nav a::before { content: '/'; color: var(--accent-2); opacity: 0; transition: opacity 0.15s; }
  nav a:hover, nav a[aria-current='page'] { color: var(--text); }
  nav a:hover::before, nav a[aria-current='page']::before { opacity: 1; }
  nav a[aria-current='page'] { text-shadow: var(--glow); }
  .toggle {
    display: grid; place-items: center; width: 36px; height: 36px; padding: 0;
    border: 1px solid var(--border); border-radius: 8px; background: var(--surface); color: var(--text); cursor: pointer;
  }
  .toggle[hidden] { display: none; }
  .toggle:hover { border-color: var(--accent); color: var(--accent); }
  .toggle svg { width: 18px; height: 18px; fill: none; stroke: currentColor; stroke-width: 1.8; stroke-linecap: round; }
  /* Show the icon for the mode you'd switch TO. */
  .sun { display: block; }
  .moon { display: none; }
  :global(:root[data-theme='light']) .sun { display: none; }
  :global(:root[data-theme='light']) .moon { display: block; }
  @media (prefers-color-scheme: light) {
    :global(:root:not([data-theme='dark'])) .sun { display: none; }
    :global(:root:not([data-theme='dark'])) .moon { display: block; }
  }
  main { padding: 3rem 16px 5rem; min-height: 70vh; }
  .site-footer {
    display: flex; justify-content: space-between; flex-wrap: wrap; gap: 0.5rem;
    border-top: 1px solid var(--border); padding-top: 1.5rem; padding-bottom: 2rem; font-size: 0.85rem;
  }
  .links { display: flex; gap: 1rem; }
  @media (max-width: 520px) {
    .brand .mono { display: none; }
    nav { gap: 0.8rem; }
    nav a { font-size: 0.82rem; }
  }
</style>
