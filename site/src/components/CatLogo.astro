---
// Cat-head mark with terminal-cursor eyes.
interface Props { size?: number }
const { size = 28 } = Astro.props;
---

<svg class="cat-logo" width={size} height={size} viewBox="0 0 32 32" aria-hidden="true" focusable="false">
  <path class="head" d="M5 27V11.5L8.5 4l5 6h5l5-6L27 11.5V27c0 1.1-.9 2-2 2H7c-1.1 0-2-.9-2-2z" />
  <rect class="eye" x="10" y="15" width="3.2" height="5" rx="0.6" />
  <rect class="eye blink" x="18.8" y="15" width="3.2" height="5" rx="0.6" />
  <path class="whisker" d="M2 19h5M2 22.5l5-1M30 19h-5M30 22.5l-5-1" />
</svg>

<style>
  .cat-logo { display: block; overflow: visible; }
  .head { fill: none; stroke: var(--text); stroke-width: 2; stroke-linejoin: round; }
  .eye { fill: var(--accent); filter: drop-shadow(0 0 3px var(--accent)); }
  .blink { animation: blink 4s steps(1) infinite; }
  .whisker { stroke: var(--muted); stroke-width: 1.2; stroke-linecap: round; }
  @keyframes blink { 0%, 92% { opacity: 1; } 93%, 100% { opacity: 0; } }
</style>
